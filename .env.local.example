# Copy this file to .env.local and fill in the values for local development.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/election?sslmode=require
# Google Cloud Vision — fallback for the single-file upload endpoint
# (/api/ocr) when no OCR API above is configured.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# --- Structured extraction engines (bulk pipeline: npm run db:ocr) ---
# These do not OCR page images; they read whole PDFs with a vision LLM and
# return the Form 26 fields as JSON. Selection order when --engine is omitted:
#   openrouter -> gemini -> baidu -> unlimited -> tesseract

# Google Gemini (free-tier friendly; gemini-3-flash-preview by default)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_OCR_MODEL=gemini-3-flash-preview
# Minimum gap between Gemini requests across all workers (ms). Raise if you
# hit 429s; lower only if your quota allows it.
GEMINI_MIN_INTERVAL_MS=4000

# OpenRouter (pay-per-token; ends in ":free" to use the free model tier)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_OCR_MODEL=qwen/qwen3-vl-32b-instruct
OPENROUTER_MIN_INTERVAL_MS=1200
# Hard stop for the pipeline when projected spend passes this many USD:
#   npm run db:ocr -- --engine=openrouter --budget-cap=0.50

# Baidu Cloud OCR (fully managed Unlimited-OCR API, no GPU needed)
# Free testing: 200 pages (personal) / 1000 pages (business verification).
# Get API Key + Secret Key from https://console.bce.baidu.com -> 文字识别 -> 智能文档分析 -> 文档解析（Unlimited-OCR）
# When set, this becomes the primary OCR engine for the upload endpoint
# (/api/ocr) and for `npm run db:ocr -- --engine=baidu`.
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# Baidu Unlimited-OCR self-hosted (OpenAI-compatible SGLang / vLLM server) — fallback
# when BAIDU_API_KEY is unset. Requires an NVIDIA GPU machine or a GPU cloud instance:
#   SGLang: python -m sglang.launch_server --model baidu/Unlimited-OCR --host 0.0.0.0 --port 10000 ...
#   vLLM:   docker run --gpus all --network host vllm/vllm-openai:unlimited-ocr baidu/Unlimited-OCR
#           --logits_processors vllm.model_executor.models.unlimited_ocr:NGramPerReqLogitsProcessor
UNLIMITED_OCR_URL=http://127.0.0.1:10000
UNLIMITED_OCR_BACKEND=vllm
UNLIMITED_OCR_MODEL=Unlimited-OCR
UNLIMITED_OCR_PROMPT=<image>document parsing.
UNLIMITED_OCR_NGRAM_SIZE=35